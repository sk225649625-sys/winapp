<Window x:Class="ReelForge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ReelForge"
        Width="1500" Height="920"
        MinWidth="1150" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop">
    <Grid Background="{StaticResource Bg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="255"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="320"/>
        </Grid.ColumnDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Grid.ColumnSpan="3" Background="#0D1017" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True" Margin="10,7">
                <TextBlock DockPanel.Dock="Left" Text="ReelForge" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" Margin="3,0,18,0"/>
                <TextBlock DockPanel.Dock="Left" Text="native • C# + C++ • local PC" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>

                <Button DockPanel.Dock="Right" x:Name="BtnExport" Click="BtnExport_Click" Content="Export" Background="{StaticResource Accent}" Foreground="#17100A" FontWeight="Bold" Padding="16,8"/>
                <Button DockPanel.Dock="Right" Click="BtnOpenExportFolder_Click" Content="Exports folder"/>
                <Button DockPanel.Dock="Right" Click="BtnLoadProject_Click" Content="Open project"/>
                <Button DockPanel.Dock="Right" Click="BtnSaveProject_Click" Content="Save project"/>

                <StackPanel Orientation="Horizontal" Margin="20,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Ratio" Foreground="{StaticResource Muted}" FontSize="11"/>
                        <ComboBox x:Name="CmbRatio" Width="92" SelectionChanged="Settings_Changed">
                            <ComboBoxItem Content="16:9" IsSelected="True"/>
                            <ComboBoxItem Content="9:16"/>
                            <ComboBoxItem Content="1:1"/>
                            <ComboBoxItem Content="4:5"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Quality" Foreground="{StaticResource Muted}" FontSize="11"/>
                        <ComboBox x:Name="CmbQuality" Width="92" SelectionChanged="Settings_Changed">
                            <ComboBoxItem Content="1080p" IsSelected="True"/>
                            <ComboBoxItem Content="720p"/>
                            <ComboBoxItem Content="480p"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="FPS" Foreground="{StaticResource Muted}" FontSize="11"/>
                        <ComboBox x:Name="CmbFps" Width="78" SelectionChanged="Settings_Changed">
                            <ComboBoxItem Content="30" IsSelected="True"/>
                            <ComboBoxItem Content="24"/>
                            <ComboBoxItem Content="60"/>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Media library -->
        <Border Grid.Row="1" Grid.Column="0" BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0" Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="28"/>
                    <RowDefinition Height="42"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="145"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Media library" FontWeight="SemiBold" VerticalAlignment="Center"/>

                <Border Grid.Row="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="6" Padding="6" Margin="0,4">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Add" Click="BtnAddMixed_Click"/>
                        <TextBlock Text="Any drive • C:\  D:\  E:\  F:\" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>

                <ListBox Grid.Row="2" x:Name="MediaList" MouseDoubleClick="MediaList_DoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="6" Margin="0,2">
                                <Grid Margin="7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="58"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Type}" FontSize="11" Foreground="{StaticResource Accent2}" VerticalAlignment="Top"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding FullPath}" FontSize="10" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="+ timeline" Padding="5,3" Click="MediaAddTimeline_Click"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="3" Orientation="Vertical">
                    <TextBlock Text="Quick add" FontWeight="SemiBold" Margin="2,4,2,2"/>
                    <WrapPanel>
                        <Button Content="+ Image / Video" Click="BtnAddVideo_Click"/>
                        <Button Content="+ Music" Click="BtnAddMusic_Click"/>
                        <Button Content="+ SFX" Click="BtnAddSfx_Click"/>
                        <Button Content="+ Voice" Click="BtnAddVoice_Click"/>
                    </WrapPanel>
                    <TextBlock Text="Files drive par hi rahenge. ReelForge unhe upload nahi karta."
                               TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="3,8,3,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Preview -->
        <Grid Grid.Row="1" Grid.Column="1" Background="#090B10">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="58"/>
            </Grid.RowDefinitions>

            <Border Margin="16" Background="#020304" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="8">
                <Grid>
                    <TextBlock x:Name="PreviewEmpty" Text="Timeline khaali hai"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{StaticResource Muted}" FontSize="16"/>
                    <Image x:Name="PreviewImage" Stretch="Uniform" Visibility="Collapsed"/>
                    <MediaElement x:Name="PreviewVideo" LoadedBehavior="Manual" UnloadedBehavior="Stop"
                                  Visibility="Collapsed" Stretch="Uniform"/>
                </Grid>
            </Border>

            <DockPanel Grid.Row="1" Margin="16,0,16,10">
                <TextBlock DockPanel.Dock="Right" x:Name="TimeText" Text="00:00 / 00:00" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                <Button DockPanel.Dock="Left" Content="◀" Click="BtnPrev_Click"/>
                <Button DockPanel.Dock="Left" Content="▶ / ❚❚" Click="BtnPlayPause_Click"/>
                <Button DockPanel.Dock="Left" Content="Reset" Click="BtnResetPreview_Click"/>
                <Slider x:Name="PreviewSeek" Minimum="0" Maximum="1" Margin="8,0" VerticalAlignment="Center"
                        ValueChanged="PreviewSeek_ValueChanged"/>
            </DockPanel>
        </Grid>

        <!-- Inspector -->
        <Border Grid.Row="1" Grid.Column="2" BorderBrush="{StaticResource Border}" BorderThickness="1,0,0,0" Padding="8">
            <TabControl x:Name="InspectorTabs">
                <TabItem Header="Clip">
                    <StackPanel Margin="10">
                        <TextBlock Text="Selected clip" FontWeight="SemiBold"/>
                        <TextBlock x:Name="InspectorName" Text="kuch select nahi" Foreground="{StaticResource Muted}" Margin="0,4,0,12"/>
                        <TextBlock Text="Duration"/>
                        <Slider x:Name="DurationSlider" Minimum="1" Maximum="30" Value="5" ValueChanged="DurationSlider_ValueChanged"/>
                        <TextBlock Text="Motion" Margin="0,12,0,4"/>
                        <ComboBox x:Name="MotionCombo">
                            <ComboBoxItem Content="none" IsSelected="True"/>
                            <ComboBoxItem Content="kenIn"/>
                            <ComboBoxItem Content="kenOut"/>
                            <ComboBoxItem Content="panLR"/>
                            <ComboBoxItem Content="panRL"/>
                            <ComboBoxItem Content="float"/>
                            <ComboBoxItem Content="dolly"/>
                        </ComboBox>
                        <TextBlock Text="Transition" Margin="0,12,0,4"/>
                        <ComboBox>
                            <ComboBoxItem Content="none" IsSelected="True"/>
                            <ComboBoxItem Content="fade"/>
                            <ComboBoxItem Content="zoom"/>
                            <ComboBoxItem Content="whip"/>
                            <ComboBoxItem Content="push"/>
                            <ComboBoxItem Content="flash"/>
                        </ComboBox>
                    </StackPanel>
                </TabItem>

                <TabItem Header="Video FX">
                    <StackPanel Margin="10">
                        <CheckBox Content="Grain" Margin="0,5"/>
                        <CheckBox Content="Vignette" Margin="0,5"/>
                        <CheckBox Content="Letterbox" Margin="0,5"/>
                        <CheckBox Content="Warm" Margin="0,5"/>
                        <CheckBox Content="Cool" Margin="0,5"/>
                        <CheckBox Content="Cine" Margin="0,5"/>
                    </StackPanel>
                </TabItem>

                <TabItem Header="Audio">
                    <StackPanel Margin="10">
                        <CheckBox Content="Bass" Margin="0,5"/>
                        <CheckBox Content="Treble" Margin="0,5"/>
                        <CheckBox Content="Muffle" Margin="0,5"/>
                        <CheckBox Content="Echo" Margin="0,5"/>
                        <CheckBox Content="Crush" Margin="0,5"/>
                    </StackPanel>
                </TabItem>

                <TabItem Header="Text">
                    <StackPanel Margin="10">
                        <TextBlock Text="Native text overlay editor"/>
                        <TextBox x:Name="TextOverlayBox" Height="70" Margin="0,8" TextWrapping="Wrap" AcceptsReturn="True"/>
                        <ComboBox>
                            <ComboBoxItem Content="Fade up" IsSelected="True"/>
                            <ComboBoxItem Content="Type"/>
                            <ComboBoxItem Content="Pop"/>
                            <ComboBoxItem Content="Slide"/>
                        </ComboBox>
                        <Button Content="Add text to selected clip" Click="BtnAddText_Click"/>
                    </StackPanel>
                </TabItem>
            </TabControl>
        </Border>

        <!-- Timeline -->
        <Border Grid.Row="2" Grid.ColumnSpan="3" Background="#131721" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="34"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0">
                    <TextBlock Text="Timeline" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock DockPanel.Dock="Right" x:Name="TimelineInfo" Text="0 clips" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                    <Button DockPanel.Dock="Right" Content="Remove selected" Click="BtnRemoveClip_Click"/>
                    <Button DockPanel.Dock="Right" Content="Add selected" Click="BtnAddSelectedToTimeline_Click"/>
                </DockPanel>

                <ListBox Grid.Row="1" x:Name="TimelineList"
                         SelectionChanged="TimelineList_SelectionChanged"
                         AllowDrop="True"
                         Drop="Timeline_Drop">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#1A2030" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="7" Margin="4" Padding="10" MinWidth="150">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Type}" Foreground="{StaticResource Accent2}" FontSize="11"/>
                                    <TextBlock Text="{Binding DurationSeconds, StringFormat={}{0:0.0}s}" Foreground="{StaticResource Muted}" FontSize="11"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- Status -->
        <Border Grid.Row="3" Grid.ColumnSpan="3" Background="#0B0D12" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0">
            <DockPanel Margin="10,0">
                <TextBlock DockPanel.Dock="Right" x:Name="StatusText" Text="Ready • local PC" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                <TextBlock Text="No server • no browser tab • files stay on your drives" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
